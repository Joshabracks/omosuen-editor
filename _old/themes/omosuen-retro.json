  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5a6e42", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#d4a843" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#c45a4a" }
    },
    {
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#b0c47a" }
    },
    {
      "scope": ["constant.language"],
      "settings": { "foreground": "#4a8ac4" }
    },
    {
      "scope": ["constant.character", "constant.character.escape"],
      "settings": { "foreground": "#d4a843" }
    },
    {
      "scope": ["keyword.control", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.flow", "keyword.control.conditional", "keyword.control.loop"],
      "settings": { "foreground": "#c45a8a" }
    },
    {
      "scope": ["storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.instanceof", "keyword.operator.typeof", "keyword.operator.sizeof", "keyword.operator.wordlike"],
      "settings": { "foreground": "#4a8ac4" }
    },
    {
      "scope": ["keyword"],
      "settings": { "foreground": "#c45a8a" }
    },
    {
      "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical", "keyword.operator.comparison", "keyword.operator.ternary"],
      "settings": { "foreground": "#8a7e6e" }
    },
    {
      "scope": ["entity.name.function", "support.function", "entity.name.operator.custom-literal"],
      "settings": { "foreground": "#dbc978" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class"],
      "settings": { "foreground": "#4a9dbb" }
    },
    {
      "scope": ["entity.other.inherited-class"],
      "settings": { "foreground": "#4a9dbb", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#c45a4a" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#9ab8c7" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#9ab8c7" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#d47a3c" }
    },
    {
      "scope": ["variable.language"],
      "settings": { "foreground": "#4a8ac4", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.other.constant"],
      "settings": { "foreground": "#4a9dbb" }
    },
    {
      "scope": ["meta.object-literal.key"],
      "settings": { "foreground": "#9ab8c7" }
    },
    {
      "scope": ["punctuation"],
      "settings": { "foreground": "#8a7e6e" }
    },
    {
      "scope": ["support.type.property-name"],
      "settings": { "foreground": "#9ab8c7" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#d4a843", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#d47a3c" }
    },
    {
      "scope": ["meta.diff.header"],
      "settings": { "foreground": "#4a8ac4" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#c45a8a" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#8ebc3a" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#d4a843" }
    }
  ]
}
